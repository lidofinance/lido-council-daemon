{
  "name": "lido-council-daemon",
  "version": "4.1.2",
  "description": "Lido Council Daemon",
  "author": "Lido team",
  "private": true,
  "license": "Apache-2.0",
  "config": {
    "dockerorg": "lidofinance"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "NODE_OPTIONS=--max-old-space-size=8192 nest start",
    "start:dev": "NODE_OPTIONS=--max-old-space-size=8192 nest start --watch",
    "start:debug": "NODE_OPTIONS=--max-old-space-size=8192 nest start --debug --watch",
    "start:prod": "node --max-old-space-size=8192 dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" hardhat.config.ts",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "ts-node -r tsconfig-paths/register test/e2e-preflight.ts && rimraf cache && jest --runInBand --forceExit --config ./test/jest-e2e.json",
    "test:e2e:edf-transition": "rimraf cache && jest --runInBand --forceExit --config ./test/jest-e2e.json test/edf-locator-transition.e2e-spec.ts",
    "test:e2e:debug": "E2E_SILENT_LOGS=false ts-node -r tsconfig-paths/register test/e2e-preflight.ts && rimraf cache && E2E_SILENT_LOGS=false jest --detectOpenHandles --runInBand --forceExit --config ./test/jest-e2e.json --silent=false",
    "typechain": "rimraf src/generated && typechain --target=ethers-v5 --out-dir ./src/generated ./src/abi/*.json",
    "typecheck": "tsc --noEmit --pretty false -p tsconfig.json && tsc --noEmit --pretty false -p tsconfig.hardhat.json",
    "postinstall": "yarn typechain",
    "docker:build": "docker build -t $npm_package_config_dockerorg/$npm_package_name:$npm_package_version .",
    "docker:push": "docker push $npm_package_config_dockerorg/$npm_package_name:$npm_package_version",
    "cache:clear": "rimraf cache",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" hardhat.config.ts --fix"
  },
  "dependencies": {
    "@chainsafe/as-sha256": "0.5.0",
    "@chainsafe/blst": "2.2.0",
    "@chainsafe/ssz": "0.18.0",
    "@lido-nestjs/constants": "5.3.0",
    "@lido-nestjs/execution": "1.23.1",
    "@lido-nestjs/fetch": "1.4.0",
    "@lido-nestjs/key-validation": "8.3.6",
    "@lido-nestjs/middleware": "1.2.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/terminus": "11.1.1",
    "@prometheus-io/client": "0.16.1",
    "@willsoto/nestjs-prometheus": "7.0.0",
    "app-root-path": "3.1.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compare-versions": "6.1.1",
    "dotenv": "18.0.8",
    "ethers": "5.8.0",
    "kafkajs": "2.2.4",
    "level": "10.0.0",
    "lru-cache": "11.5.3",
    "nest-winston": "2.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "winston": "3.19.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ethersproject/abi": "5.8.0",
    "@ethersproject/providers": "5.8.0",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@typechain/ethers-v5": "11.1.2",
    "@types/jest": "30.0.0",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "dockerode": "5.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.13.0",
    "hardhat": "2.29.1",
    "jest": "30.5.2",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typechain": "8.3.2",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "moduleDirectories": [
      "node_modules",
      "src"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "engines": {
    "node": "24.22.1",
    "yarn": "1.22.22"
  },
  "resolutions": {
    "piscina": "4.9.4",
    "**/@ethersproject/providers/ws": "8.22.0",
    "**/hardhat/undici": "6.29.1",
    "**/hardhat/uuid": "11.1.1",
    "**/hardhat/adm-zip": "0.6.1",
    "**/solc/tmp": "0.2.7",
    "**/mocha/diff": "8.0.4",
    "**/mocha/serialize-javascript": "7.1.2",
    "**/@sentry/node/cookie": "0.7.2",
    "**/@istanbuljs/load-nyc-config/js-yaml": "4.3.2"
  }
}
